{
  "name": "dsh-stall-governor",
  "version": "0.1.0",
  "description": "失速治理单包双引擎：单流内退化软切（源自 dsh-cot-anchor）与跨步骤空转熔断（源自 dsh-step-governor）共享装配/设置/事件设施；确定性判据、shadow 灰度、fail-open",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "governor",
    "circuit-breaker",
    "cot",
    "soft-cut"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "license": "MIT"
}
