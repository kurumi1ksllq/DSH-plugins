{
  "name": "dsh-inventory",
  "version": "0.12.3",
  "private": true,
  "description": "Inventory for DeepSeek Harness: installed plugin packages, loader rows, MCP servers, skills and tools — plus a per-workspace view that assigns or removes an MCP server / skill with one click. Adds an 'Inventory' tab under Settings > Plugins.",
  "type": "module",
  "icon": "icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./gate": "./gate.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./prompt-inject": "./lib-prompt-inject.js"
  },
  "files": [
    "index.js",
    "gate.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "lib-prompt-inject.js",
    "VERIFICATION.md",
    "README-prompt-inject.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "inventory",
    "skills",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurumi1ksllq/dsh-inventory.git"
  },
  "homepage": "https://github.com/kurumi1ksllq/dsh-inventory#readme",
  "bugs": {
    "url": "https://github.com/kurumi1ksllq/dsh-inventory/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "*"
  }
}
