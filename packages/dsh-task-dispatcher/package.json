{
  "name": "dsh-task-dispatcher",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Task dispatcher: injects a delegation discipline with COUNTABLE split triggers and a declarative subagent routing table as a runtime context, and registers role_search (Chinese and English keywords) / delegate_role so the lead agent and every teammate can hand a subtask to a specialist ROLE whose child inherits the full toolset",
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./delegation-text": "./lib/delegation-text.mjs",
    "./roles": "./lib/roles.mjs",
    "./delegate": "./lib/delegate.mjs",
    "./icon": "./icon.svg",
    "./locale/en": "./locale/en.json",
    "./locale/zh": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "js-yaml": "4.3.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
