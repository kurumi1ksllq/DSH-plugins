{
  "name": "dev-flow",
  "version": "0.8.0",
  "description": "dev-flow bundle for DeepSeek Harness: the engineering flow (issue → branch → TDD → PR → CI → review → merge) injected as an always-on system-prompt contract, with exactly two user interactions (intent, merge) and an agent-decided path in between. Ships FLOW.md plus contract/doc linters that keep the gates intact under edits.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lint": "./lib/lint.mjs",
    "./contract": "./lib/contract.mjs",
    "./git-status": "./git-status-host.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "FLOW.md",
    "index.js",
    "git-status-host.js",
    "lib",
    "lib-git-status",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README-git-status.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0"
  },
  "icon": "icon.svg",
  "private": true
}
