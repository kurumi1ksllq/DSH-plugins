{
  "name": "dsh-skill-surface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gives every agent the official skill catalog and loader by mounting the official host rows into the global layer, and injects skills named by a `skills:` handoff line when the lead delegates",
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./handoff": "./lib/handoff.mjs",
    "./protocol": "./lib/protocol.mjs",
    "./icon": "./icon.svg",
    "./locale/en": "./locale/en.json",
    "./locale/zh": "./locale/zh.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-skill": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  }
}
