{
  "name": "dsh-skill-surface",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Fallback skill discovery for agents whose preset mounts no skill provider: an official filesystem provider in the global layer, a skill_get loader and a hint that stay silent whenever the official skill tool already exists",
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./handoff": "./lib/handoff.mjs",
    "./protocol": "./lib/protocol.mjs",
    "./icon": "./icon.svg",
    "./locale/en": "./locale/en.json",
    "./locale/zh": "./locale/zh.json",
    "./package.json": "./package.json",
    "./host-api": "./lib/host-api.mjs",
    "./catalog-hint": "./lib/catalog-hint.mjs",
    "./domains": "./lib/domains.mjs",
    "./intent-map": "./lib/intent-map.mjs"
  },
  "files": [
    "index.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-skill-filesystem": "*",
    "@deepseek-ai/dsh-web-app": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-app": {
      "optional": true
    }
  }
}
