{
  "name": "dsh-plugin-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Boot-time plugin reconciliation for DeepSeek Harness: read a target git repository's manifest, compare it against the plugins installed in this profile, and report or install the difference.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin-sync",
    "boot",
    "manifest"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
