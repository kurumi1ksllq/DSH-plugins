{
  "name": "dsh-credential-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Credential vault for DeepSeek Harness: store server passwords, GitHub tokens and API keys AES-256-GCM encrypted under $DSH_HOME, expose one `credential` tool for the model to read them by name on demand, plus a sidebar manager with a read audit log. Plaintext never appears in the session log or the HTTP API responses the panel uses.",
  "type": "module",
  "icon": "icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "credentials",
    "secrets",
    "vault",
    "sidebar"
  ],
  "license": "MIT"
}
