{
  "name": "dsh-websearch-failover",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "DSH bundle: ordered multi-provider web_search failover with quota-aware cooldown, plus a left-sidebar provider manager that shows every provider's balance in its own billing unit and when that quota resets",
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0"
  },
  "scripts": {
    "test": "node --test test/mock-failover.mjs test/test-*.mjs",
    "test:engine": "node test/mock-failover.mjs",
    "test:runtime": "node test/test-runtime.mjs",
    "test:balance": "node test/test-balance.mjs",
    "test:api": "node test/test-api.mjs",
    "test:plugin": "node test/test-host-plugin.mjs",
    "test:integration": "node test/test-integration.mjs",
    "test:client": "node test/test-client-static.mjs",
    "test:render": "node test/test-client-render.mjs",
    "verify:installed": "node tools/verify-installed.mjs",
    "search": "node search.mjs",
    "probe": "node search.mjs --probe",
    "probe:balance": "node tools/probe-balance-endpoints.mjs",
    "list": "node search.mjs --list",
    "asar:get": "node tools/asar-get.cjs",
    "asar:files": "node tools/asar-files.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "providers.example.json"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
