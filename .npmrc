# Bundle peerDependencies (e.g. the @deepseek-ai/* packages declared by
# packages/dsh-deep-ptc-mode) must NOT be auto-installed from the registry.
# For `link:` installs the host routes those package names to the running
# runtime; a registry copy inside the workspace would shadow it and pin a
# possibly different build. See docs/specs/deep-ptc-integration.md.
auto-install-peers=false
