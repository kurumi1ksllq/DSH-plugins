{
  "name": "@local/dsh-prompt-inject",
  "version": "0.1.0",
  "private": true,
  "description": "Host-only DeepSeek Harness demo bundle that appends one small bilingual section with the verification token DSH-INJECT-7F3A-2026 to every agent system prompt.",
  "type": "module",
  "icon": "icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "system-prompt",
    "prompt-injection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurumi1ksllq/dsh-reverse-plugin.git"
  }
}
