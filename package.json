{
  "name": "dsh-plugins-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "One repository, eight independently installable DeepSeek Harness bundles. Each directory under packages/ carries its own package.json, cordis.patch.yml and version; a DSH profile links to the bundle directory it needs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present run test && node --test test/*.test.mjs",
    "test:inventory": "pnpm --filter dsh-inventory run test",
    "test:websearch": "pnpm --filter websearch-dsh-plugin run test",
    "test:prompt-inject": "node --test packages/dsh-prompt-inject/test/*.test.mjs",
    "test:dev-flow": "node --test packages/dev-flow/test/*.test.mjs",
    "build:websearch": "pnpm --filter websearch-dsh-plugin run build",
    "check:websearch": "pnpm --filter websearch-dsh-plugin run build:check",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "verify": "node scripts/verify-packages.mjs && node scripts/check-artifacts.mjs && node scripts/check-profile.mjs && node scripts/check-bundle-versions.mjs",
    "gate": "pnpm verify && pnpm test",
    "check:profile": "node scripts/check-profile.mjs",
    "check:versions": "node scripts/check-bundle-versions.mjs",
    "test:docs": "node --test test/*.test.mjs",
    "vault:export": "node packages/dsh-credential-vault/bin/vault-sync.mjs export",
    "vault:import": "node packages/dsh-credential-vault/bin/vault-sync.mjs import"
  }
}
