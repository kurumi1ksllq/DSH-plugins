{
  "name": "dsh-plugins-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "One repository, five independently installable DeepSeek Harness bundles. Each directory under packages/ carries its own package.json, cordis.patch.yml and version; the DSH profile links to the bundle directory it needs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --if-present run test",
    "test:ctx-guard": "pnpm --filter dsh-ctx-guard run test",
    "test:inventory": "pnpm --filter dsh-inventory run test",
    "test:websearch": "pnpm --filter websearch-dsh-plugin run test",
    "test:prompt-inject": "node --test packages/dsh-prompt-inject/prompt-inject/test/plugin.test.mjs",
    "build:websearch": "pnpm --filter websearch-dsh-plugin run build",
    "check:websearch": "pnpm --filter websearch-dsh-plugin run build:check",
    "verify": "node scripts/verify-packages.mjs",
    "verify:web-profile": "node scripts/verify-web-profile.mjs"
  }
}
