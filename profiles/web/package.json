{
  "name": "dsh-profile-web",
  "private": true,
  "description": "Server-side DSH web profile. Links the bundles in this repository by relative path so the same file works on Windows and Linux. dsh-git-bash-tool and browser-skill are deliberately absent (see README).",
  "dependencies": {
    "@local/dsh-prompt-inject": "link:../../packages/dsh-prompt-inject",
    "dsh-ctx-guard": "link:../../packages/dsh-ctx-guard",
    "dsh-inventory": "link:../../packages/dsh-inventory",
    "dsh-websearch-failover": "link:../../packages/dsh-websearch-failover/plugin",
    "dsh-context": "0.74.0",
    "dsh-plugin-save-token": "^2.4.1",
    "dsh-tool-search": "0.1.8"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@deepseek-ai/dsh-experimental-agent-team-profile",
        "@deepseek-ai/dsh-experimental-auto-review",
        "@deepseek-ai/dsh-experimental-terminal-bundle",
        "@deepseek-ai/dsh-experimental-tool-worktree",
        "@deepseek-ai/dsh-experimental-session-search",
        "dsh-context",
        "dsh-plugin-save-token",
        "dsh-tool-search",
        "@deepseek-ai/dsh-experimental-ralph-bundle",
        "dsh-inventory",
        "@local/dsh-prompt-inject",
        "dsh-ctx-guard",
        "dsh-websearch-failover"
      ]
    }
  }
}
